# dependencies
node_modules/

.venv/
__pycache__/
*.pyc
*.egg-info/
.env

# Additional Python caches and test artifacts
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo

# generated native folders
*/ios
*/android

# google-services
google-services.json

# Firebase service-account credentials — must NEVER be committed (OSR-004)
# NOTE: `secrets/*` (not `secrets/`) so the negation below actually works —
# git won't descend into a wholly-excluded directory.
secrets/*
!secrets/README.md
firebase-adminsdk-*.json
*-firebase-adminsdk-*.json
vitrolify-sa*.json

# local notes and tools
docs/
.claude/
.idea/